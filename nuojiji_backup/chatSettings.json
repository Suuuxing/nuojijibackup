k/document.xmlPK\u0001\u0002?\u0003\u0014\u0000\u0002\u0000\b\u0000+��\\XW��)\u0000\u0000\u00007\u0000\u0000\u0000\u0011\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000��s&\u0000\u0000tbak/modified.xmlPK\u0005\u0006\u0000\u0000\u0000\u0000\f\u0000\f\u0000�\u0002\u0000\u0000�&\u0000\u0000/\u0000Mon Apr 13 23:57:23 2026\n:hfdocument-office:1.9","userBubbleCSS":"/*   仿微信夜间 by water   */\n/*   感谢砂砂老师提供的美化代码๑⁃̀⩊⁃́๑   */\n/* 可以修改的地方用🩵标注啦 可以自己调适配 禁止二传 二改自用 */\n\n/* =========================================\n   【可直接调整区】底栏按钮位置与大小\n========================================= */\n:root {\n  /* --- 🩵底栏基础高度 --- */\n  --chat-bottom-height: 90px;\n\n  /* --- 🩵输入框 --- */\n  --input-box-width: 240px;\n  --input-box-height: 36px;\n  --input-box-top: 10px;\n  --input-box-left: 50px;\n  --input-text-color: #1a1a1a;\n\n  /* --- 🩵语音按钮（输入框内右侧） --- */\n  --mic-width: 24px;\n  --mic-height: 24px;\n  --mic-top: 10px;\n  --mic-right: 106px;\n\n  /* --- 🩵表情按钮 --- */\n  --sticker-width: 22px;\n  --sticker-height: 22px;\n  --sticker-top: 10px;\n  --sticker-left: 298px;\n\n  /* --- 🩵菜单/加号按钮 --- */\n  --plus-width: 34px;\n  --plus-height: 36px;\n  --plus-top: 11px;\n  --plus-left: 10px;\n\n  /* --- 🩵AI等待回复按钮 --- */\n  --ai-width: 38px;\n  --ai-height: 38px;\n  --ai-top: 8px;\n  --ai-left: 340px;\n\n  /* --- 🩵发送按钮（打字时显示） --- */\n  --send-width: 60px;\n  --send-height: 60px;\n  --send-top: -7px;\n  --send-left: 330px;\n\n  /* --- 🩵打字时发送键左侧装饰图（仅装饰） --- */\n  --dec-width: 35px;\n  --dec-height: 35px;\n  --dec-top: 12px;\n  --dec-left: 295px;\n} /* 【修复】：补全了缺失的右大括号 */\n\n/* =========================================\n   仿微信顶栏 (Header) 深度定制\n========================================= */\n\n.chat-header-custom {\n  background-color: rgba(25, 25, 25, 0.85) !important;\n  backdrop-filter: blur(12px) !important;\n  -webkit-backdrop-filter: blur(12px) !important;\n  border-bottom: 0.8px solid #2a2a2a !important;\n  border-top: none !important;\n  border-left: none !important;\n  border-right: none !important;\n  height: 95px !important;/* 顶栏高度🩵 */\n  min-height: 95px !important;\n}\n\n.header-profile-section {\n  position: absolute !important;\n  left: 50% !important;\n  top: 50% !important;\n  transform: translate(-50%, -50%) !important;\n  margin-top: 20px !important;/* 🩵备注位置 */\n  margin-left: 0px !important;\n  justify-content: center !important;\n  pointer-events: none !important;\n}\n\n/* 【修复】：显式指定标题文字颜色，防止被覆盖 */\n.chat-header-title {\n  color: #cfcfcf !important;\n}\n\n.header-avatar-container,\n.chat-header-subtitle { display: none !important; }\n\n.header-btn-back svg { display: none !important; }\n.header-btn-back {\n  background-image: url('https://i.postimg.cc/CKVQ1B7y/无标题279_20260320142828.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  width: 20px !important;\n  height: 20px !important;\n  position: relative !important;\n  top: 0px !important;\n  left: 4px !important;\n  background-color: transparent !important;\n  border: none !important;\n}\n\n.header-action-btn svg { opacity: 0 !important; }\n\n.header-action-btn:last-child {\n  background-image: url('https://i.postimg.cc/7LMQTHsR/无标题279_20260320142859.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  width: 24px !important;\n  height: 24px !important;\n  min-width: 24px !important;\n  position: relative !important;\n  top: 0px !important;\n  right: 2px !important;\n  background-color: transparent !important;\n}\n\n.chat-header-actions {\n  gap: 12px !important;\n  padding-right: 12px !important;\n}\n\n/* =========================================\n   底栏背景与分割线\n========================================= */\n.input-area-custom {\n  background-color: rgba(28, 28, 28, 0.85) !important;\n  backdrop-filter: blur(12px) !important;\n  -webkit-backdrop-filter: blur(12px) !important;\n  border-top: 0.8px solid #343434 !important;\n  border-bottom: none !important;\n  border-left: none !important;\n  border-right: none !important;\n  min-height: var(--chat-bottom-height) !important;\n  box-shadow: none !important;\n  position: relative !important;\n}\n\n.input-action-bar-custom,\n.input-row-wrapper {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n\n/* =========================================\n   输入框本体\n========================================= */\ntextarea.input-box-custom,\n.input-box-custom {\n  width: var(--input-box-width) !important;\n  height: var(--input-box-height) !important;\n  min-height: var(--input-box-height) !important;\n  background: #2c2c2c !important;\n  background-color: #2c2c2c!important;\n  \n  /* 【修复】：将此处原本的 #ffffff 修改为 #2c2c2c，否则内阴影会让输入框看起来是白色的 */\n  box-shadow: inset 0 0 0 9999px #2c2c2c !important; \n  \n  border-radius: 6px !important;\n  border: none !important;\n  position: absolute !important;\n  top: var(--input-box-top) !important;\n  left: var(--input-box-left) !important;\n  padding: 8px 36px 8px 10px !important;\n  color: var(--input-text-color) !important;\n  -webkit-text-fill-color: var(--input-text-color) !important;\n  font-size: 15px !important;\n  box-sizing: border-box !important;\n  z-index: 20 !important;\n}\n\ntextarea.input-box-custom::placeholder,\n.input-box-custom::placeholder {\n  color: transparent !important;\n  -webkit-text-fill-color: transparent !important;\n  opacity: 0 !important;\n}\n\n/* =========================================\n   独立按钮替换与排版 (已修复菜单消失)\n========================================= */\n\n/* 1. 语音按钮 */\n.input-btn-mic svg { display: none !important; }\n.input-btn-mic {\n  width: var(--mic-width) !important;\n  height: var(--mic-height) !important;\n  position: absolute !important;\n  top: var(--mic-top) !important;\n  right: var(--mic-right) !important;\n  background-image: url('https://i.postimg.cc/8CV05JH2/无标题279_20260320142508.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n  z-index: 30 !important;\n  transform: scale(0.6) !important;\n  opacity: 1 !important; /* 强制显示 */\n  display: block !important;\n}\n\n/* 2. 表情按钮 */\n.input-btn-sticker svg { display: none !important; }\n.input-btn-sticker {\n  width: var(--sticker-width) !important;\n  height: var(--sticker-height) !important;\n  position: absolute !important;\n  top: var(--sticker-top) !important;\n  left: var(--sticker-left) !important;\n  background-image: url('https://i.postimg.cc/5tqkF47s/无标题279_20260320142557.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n  z-index: 30 !important;\n  opacity: 1 !important; /* 强制显示 */\n  display: block !important;\n}\n\n/* 3. 菜单/加号按钮 */\n.input-btn-plus svg { display: none !important; }\n.input-btn-plus {\n  width: var(--plus-width) !important;\n  height: var(--plus-height) !important;\n  position: absolute !important;\n  top: var(--plus-top) !important;\n  left: var(--plus-left) !important;\n  background-image: url('https://i.postimg.cc/k5dp46ch/无标题279_20260320142413.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n  border: none !important;\n  z-index: 60 !important; \n  opacity: 1 !important; /* 洗掉 icity 里的 opacity:0 */\n  visibility: visible !important;\n  display: block !important;\n}\n\n/* 4. 等待回复 (AI) 按钮 */\n.input-btn-ai svg { display: none !important; }\n.input-btn-ai {\n  width: var(--ai-width) !important;\n  height: var(--ai-height) !important;\n  min-width: var(--ai-width) !important;\n  position: absolute !important;\n  top: var(--ai-top) !important;\n  left: var(--ai-left) !important;\n  background-image: url('https://i.postimg.cc/k5dp46ck/无标题279_20260320142426.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n  border-radius: 0 !important;\n  opacity: 1 !important;\n  z-index: 51 !important;\n  transition: opacity 0.2s !important;\n  display: block !important;\n}\n\n/* 5. 发送按钮 */\n.send-btn-custom svg { display: none !important; }\n.send-btn-custom {\n  width: var(--send-width) !important;\n  height: var(--send-height) !important;\n  min-width: var(--send-width) !important;\n  position: absolute !important;\n  top: var(--send-top) !important;\n  left: var(--send-left) !important;\n  background-image: url('https://i.postimg.cc/7LMQTHsj/无标题278_20260320141242.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  background-color: transparent !important;\n  border: none !important;\n  border-radius: 0 !important;\n  z-index: 50 !important;\n  opacity: 1 !important;\n  display: block !important;\n}\n\n/* 打字时 发送键左侧装饰图 */\n.input-area-custom:has(.input-box-custom:not(:placeholder-shown))::before {\n  content: \"\" !important;\n  position: absolute !important;\n  width: var(--dec-width) !important;\n  height: var(--dec-height) !important;\n  top: var(--dec-top) !important;\n  left: var(--dec-left) !important;\n  background-image: url('https://i.postimg.cc/5tqkF47s/无标题279_20260320142557.png') !important;\n  background-size: contain !important;\n  background-repeat: no-repeat !important;\n  background-position: center !important;\n  pointer-events: none !important;\n  z-index: 40 !important;\n}\n\n/* 防卡死补丁 */\n.input-area-custom:has(.input-box-custom:not(:placeholder-shown)) .input-btn-ai {\n  opacity: 0 !important;\n  pointer-events: none !important;\n}\n.more-options-popup { z-index: 999999 !important; }\n.input-area-custom:has(.more-options-popup) .input-btn-ai,\n.input-area-custom:has(.more-options-popup) .input-btn-plus,\n.input-area-custom:has(.more-options-popup) .input-btn-sticker,\n.input-area-custom:has(.more-options-popup) .input-btn-mic,\n.input-area-custom:has(.more-options-popup) .send-btn-custom {\n  pointer-events: none !important;\n}\n\n/* =========================================\n   【修正】系统时间、系统提示框 (解决太长的问题)\n========================================= */\n.timestamp-custom,\n.date-divider-custom,\n.system-message-custom,\n[class*=\"system-message\"],\n[class*=\"timestamp\"],\n[class*=\"date-divider\"] {\n  width: fit-content !important; /* 像微信一样紧贴文字宽度 */\n  max-width: 80% !important;\n  margin: 8px auto !important;   /* 绝对居中 */\n  \n  background-color: #292929 !important;\n  border: 0.6px solid #3e3e3e !important;\n  color: #949494 !important;\n  border-radius: 3px !important; \n  padding: 2px 10px !important;\n  \n  display: block !important;\n  text-align: center !important;\n  box-sizing: border-box !important;\n  font-size: 12px !important;\n}\n/* =========================================\n   【可直接调整区】气泡小角 (带弧度三角) 设置\n========================================= */\n:root {\n  /* --- 我方气泡小角 (右侧绿色) --- */\n  --me-tail-size: 9px;       /* 决定小角的整体大小 */\n  --me-tail-radius: 1.5px;      /* 顶尖的圆角弧度 (您要求的4px) */\n  --me-tail-top: 14px;        /* 上下位置 */\n  --me-tail-right: -4px;      /* 左右位置 (负数代表往气泡外面移) */\n\n  /* --- AI气泡小角 (左侧白色) --- */\n  --them-tail-size: 9px;     /* 决定小角的整体大小 */\n  --them-tail-radius: 1.5px;    /* 顶尖的圆角弧度 (您要求的4px) */\n  --them-tail-top: 14px;      /* 上下位置 */\n  --them-tail-left: -4px;     /* 左右位置 (负数代表往气泡外面移) */\n}\n\n/* =========================================\n   1. 我方气泡 (绿色)\n========================================= */\n.bubble-me-custom {\n  background-color: #28b561 !important;\n  background: #28b561 !important;\n  \n  /* 更改后的内边距和圆角 */\n  padding: 8px 12px !important;\n  border-radius: 4px !important;\n  \n  position: relative !important;\n  overflow: visible !important; /* 必须开启，允许小角溢出 */\n  box-shadow: none !important;\n  border: none !important;\n  z-index: 1 !important;        /* 建立层级，防止小角被背景吞掉 */\n}\n\n/* 强制我方气泡连发时不改变圆角 */\n.bubble-me-custom.first, \n.bubble-me-custom.mid, \n.bubble-me-custom.last {\n  border-radius: 4px !important;\n}\n\n/* 强制我方气泡内的文字颜色 */\n.bubble-me-custom,\n.bubble-me-custom * {\n  color: #04120a !important;\n}\n\n/* 我方气泡右侧小角 (带弧度的旋转正方形实现) */\n.bubble-me-custom::after {\n  content: \"\" !important;\n  position: absolute !important;\n  top: var(--me-tail-top) !important;\n  right: var(--me-tail-right) !important;\n  width: var(--me-tail-size) !important;\n  height: var(--me-tail-size) !important;\n  background-color: #28b561 !important;\n  \n  /* 核心：倒角4px，并旋转45度，让右上角变成向右指的圆润尖角 */\n  border-radius: var(--me-tail-radius) !important;\n  transform: rotate(45deg) !important;\n  -webkit-transform: rotate(45deg) !important;\n  z-index: -1 !important; /* 放在气泡底层，无缝融合 */\n}\n\n/* =========================================\n   2. AI / 对方气泡 (白色)\n========================================= */\n.bubble-them-custom {\n  background-color: #2c2c2c !important;\n  background: #2c2c2c !important;\n  \n  /* 更改后的内边距和圆角 */\n  padding: 8px 12px !important;\n  border-radius: 4px !important;\n  \n  position: relative !important;\n  overflow: visible !important; \n  box-shadow: none !important;\n  border: none !important;\n  z-index: 1 !important;\n}\n\n/* 强制对方气泡连发时不改变圆角 */\n.bubble-them-custom.first, \n.bubble-them-custom.mid, \n.bubble-them-custom.last {\n  border-radius: 4px !important;\n}\n\n/* 强制对方气泡内的文字颜色 */\n.bubble-them-custom,\n.bubble-them-custom * {\n  color: #d5d5d5 !important;\n}\n\n/* AI气泡左侧小角 (带弧度的旋转正方形实现) */\n.bubble-them-custom::before {\n  content: \"\" !important;\n  position: absolute !important;\n  top: var(--them-tail-top) !important;\n  left: var(--them-tail-left) !important;\n  width: var(--them-tail-size) !important;\n  height: var(--them-tail-size) !important;\n  background-color: #2c2c2c !important;\n  \n  /* 核心：倒角4px，并旋转45度，让左下角变成向左指的圆润尖角 */\n  border-radius: var(--them-tail-radius) !important;\n  transform: rotate(45deg) !important;\n  -webkit-transform: rotate(45deg) !important;\n  z-index: -1 !important; /* 放在气泡底层，无缝融合 */\n}\n/* =========================================\n   3. 特殊消息自动隐藏气泡与小角 (表情包/图片/转账等)\n========================================= */\n\n/* 当气泡内包含：图片(含表情包)、视频、图片容器、转账卡片、位置卡片、长图卡片、礼物盒 时，强制背景透明并去掉内边距 */\n.bubble-me-custom:has(img, video, .msg-image-wrapper, .msg-transfer-card, .msg-loc-card, .msg-sim-card, .gift-ig-container),\n.bubble-them-custom:has(img, video, .msg-image-wrapper, .msg-transfer-card, .msg-loc-card, .msg-sim-card, .gift-ig-container) {\n  background-color: transparent !important;\n  background: transparent !important;\n  padding: 0 !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n\n/* 强制隐藏我方特殊消息的气泡小角 */\n.bubble-me-custom:has(img, video, .msg-image-wrapper, .msg-transfer-card, .msg-loc-card, .msg-sim-card, .gift-ig-container)::after {\n  display: none !important;\n}\n\n/* 强制隐藏对方特殊消息的气泡小角 */\n.bubble-them-custom:has(img, video, .msg-image-wrapper, .msg-transfer-card, .msg-loc-card, .msg-sim-card, .gift-ig-container)::before {\n  display: none !important;\n}\n/* 输入框文字纯白色 */\ntextarea.input-box-custom,\n.input-box-custom {\n  color: #ffffff !important;\n  -webkit-text-fill-color: #ffffff !important;\n}\n/* ========== 精确去除转账卡片外层边框 ========== */\n\n/* 只处理包含转账卡片的父级容器，不影响其他消息气泡 */\n.msg-transfer-card,\n.msg-transfer-card * {\n  border: none !important;\n  outline: none !important;\n  box-shadow: none !important;\n}\n\n/* 只去掉包裹转账卡片的特定父级容器的边框 */\n.msg-transfer-card-parent,\n.msg-bubble-container:has(.msg-transfer-card) {\n  border: none !important;\n  outline: none !important;\n  box-shadow: none !important;\n  background: transparent !important;\n}\n\n/* 如果转账卡片在 msg-bubble-container 里，只去掉这个容器的边框 */\n.msg-bubble-container:has(.msg-transfer-card) {\n  border: none !important;\n  box-shadow: none !important;\n  border-radius: 0 !important;\n  background: transparent !important;\n}\n\n/* 如果转账卡片在 message-wrapper 里，只去掉这个容器的边框 */\n.message-wrapper:has(.msg-transfer-card),\n.message-wrapper.ai:has(.msg-transfer-card),\n.message-wrapper.user:has(.msg-transfer-card) {\n  border: none !important;\n  box-shadow: none !important;\n  background: transparent !important;\n}\n/* ========== 转账卡片 - 金额无类名保护版 ========== */\n\n/* 1. 全局重置 */\n.msg-transfer-card *,\n.bubble-me-custom .msg-transfer-card *,\n.bubble-them-custom .msg-transfer-card * {\n  background-image: none !important;\n  border: none !important;\n  box-shadow: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  background: transparent !important;\n}\n\n/* 2. 卡片背景 - 根据发送方区分 */\n/* 我方发出的转账卡片背景 */\n.bubble-me-custom .msg-transfer-card {\n  background: url(\"https://i.postimg.cc/x8rpvgXd/无标题22_20260324171008.png\") no-repeat center center !important;\n  background-size: 100% 100% !important;\n  border-radius: 8px !important;\n  padding: 16px 20px !important;\n  min-height: 100px !important;\n  position: relative !important;\n  overflow: visible !important;\n  box-sizing: border-box !important;\n  border: none !important;\n  margin: 0 !important;\n  display: block !important;\n}\n\n/* 对方发出的转账卡片背景 */\n.bubble-them-custom .msg-transfer-card {\n  background: url(\"https://i.postimg.cc/WzRYGSd0/无标题22_20260324171013.png\") no-repeat center center !important;\n  background-size: 100% 100% !important;\n  border-radius: 8px !important;\n  padding: 16px 20px !important;\n  min-height: 100px !important;\n  position: relative !important;\n  overflow: visible !important;\n  box-sizing: border-box !important;\n  border: none !important;\n  margin: 0 !important;\n  display: block !important;\n}\n\n/* 3. 隐藏所有图标/装饰/小符号 */\n.msg-transfer-card .transfer-icon,\n.msg-transfer-card [class*=\"icon\"],\n.msg-transfer-card [class*=\"Icon\"],\n.msg-transfer-card [class*=\"banner\"],\n.msg-transfer-card [class*=\"decoration\"],\n.msg-transfer-card [class*=\"divider\"],\n.msg-transfer-card [class*=\"line\"],\n.msg-transfer-card [class*=\"bg\"],\n.msg-transfer-card img,\n.msg-transfer-card svg,\n.msg-transfer-card [class*=\"svg\"],\n.msg-transfer-card [class*=\"SVG\"],\n.msg-transfer-card [class*=\"emoji\"],\n.msg-transfer-card [class*=\"Emoji\"],\n.msg-transfer-card [class*=\"symbol\"],\n.msg-transfer-card [class*=\"Symbol\"],\n.msg-transfer-card [class*=\"icon\"] *,\n.msg-transfer-card [class*=\"Icon\"] * {\n  display: none !important;\n  width: 0 !important;\n  height: 0 !important;\n  opacity: 0 !important;\n  overflow: hidden !important;\n  visibility: hidden !important;\n}\n/* 4. 移除伪元素 */\n.msg-transfer-card::before,\n.msg-transfer-card::after {\n  display: none !important;\n  content: none !important;\n}\n\n/* ========== 5. 标题（转账给你） ========== */\n.msg-transfer-card [class*=\"amount\"] > :nth-child(1) {\n  position: absolute !important;\n  top: 58px !important;\n  left: 0px !important;\n  z-index: 9999 !important;\n  display: inline-block !important;\n  white-space: nowrap !important;\n  font-size: 12px !important;\n  font-weight: 500 !important;\n  /* 文字透明（完全看不见） */\ncolor: transparent !important;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  line-height: 1.3 !important;\n  transform: scale(1) !important;\n  transform-origin: left top !important;\n}\n\n/* ========== 6. 金额容器（第二个子元素） ========== */\n.msg-transfer-card [class*=\"amount\"] > :nth-child(2) {\n  position: absolute !important;\n  top: -75px !important;\n  left: 50px !important;\n  z-index: 9999 !important;\n  display: inline-block !important;\n  white-space: nowrap !important;\n  transform: scale(1.5) !important;\n  transform-origin: left top !important;\n  transition: transform 0.2s ease !important;\n}\n\n/* ========== 7. 金额内部 - 无类名保护 ========== */\n/* 金额容器内所有元素（包括无类名） */\n.msg-transfer-card [class*=\"amount\"] > :nth-child(2),\n.msg-transfer-card [class*=\"amount\"] > :nth-child(2) * {\n  color: #ffffff !important;\n  opacity: 1 !important;\n  font-weight: 600 !important;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  line-height: 1.3 !important;\n  display: inline !important;\n  white-space: nowrap !important;\n  font-size: inherit !important;\n}\n\n/* ========== 8. 底部状态文字-  ========== */\n.msg-transfer-card [class*=\"status\"],\n.msg-transfer-card [class*=\"state\"] {\n  position: absolute !important;\n  top: 3px !important;\n  left: 50px !important;\n  z-index: 9999 !important;\n  display: inline-block !important;\n  white-space: nowrap !important;\n  font-size: 11px !important;\n  font-weight: 500 !important;\n/* 白色 + 不同透明度 */\ncolor: rgba(255, 255, 255, 0.8) !important;  /* 0.8 = 80%不透明，20%透明 */\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  line-height: 1.3 !important;\n  opacity: 1 !important;\n}\n\n/* ========== 9. 顶部状态文字- 单独控制 ========== */\n.msg-transfer-card [class*=\"label\"] {\n  position: absolute !important;\n  top: 20px !important;\n  right: -85px !important;\n  z-index: 9999 !important;\n  display: inline-block !important;\n  white-space: nowrap !important;\n  font-size: 10px !important;\n  font-weight: 400 !important;\n  /* 文字透明（完全看不见） */\ncolor: transparent !important;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\n  line-height: 1.3 !important;\n  opacity: 1 !important;\n}\n\n/* ========== 10. 辅助文字 - 排除金额容器内所有内容 ========== */\n/* 只影响不在 [class*=\"amount\"] 容器内的元素 */\n.msg-transfer-card > :not([class*=\"amount\"]),\n.msg-transfer-card > * > :not([class*=\"amount\"]) {\n  display: inline-block !important;\n  visibility: visible !important;\n  opacity: 1 !important;\n  color: rgba(255, 255, 255, 0.6) !important;\n  font-size: 10px !important;\n  position: relative !important;\n  top: auto !important;\n  left: auto !important;\n  z-index: 1 !important;\n  white-space: nowrap !important;\n}\n\n/* 11. 但保留标题、状态、label 不受辅助文字影响（它们已经在上面单独控制了） */\n/* 只隐藏卡片最外层、不在 amount 容器内、不在 label 容器内、无类名的元素 */\n.msg-transfer-card > :not([class*=\"amount\"]):not([class*=\"label\"]):not([class]),\n.msg-transfer-card > * > :not([class*=\"amount\"]):not([class*=\"label\"]):not([class]) {\n  display: none !important;\n  visibility: hidden !important;\n  width: 0 !important;\n  height: 0 !important;\n  opacity: 0 !important;\n}\n/* 我方转账卡片：向上 + 向右 */\n.bubble-me-custom .msg-transfer-card {\n  transform: translate(10px, -10px) !important;  /* X轴向右10px, Y轴向上-10px */\n  margin: 0 !important;  /* 保持margin为0，避免冲突 */\n}\n\n/* 对方转账卡片：向上 + 向左 */\n.bubble-them-custom .msg-transfer-card {\n  transform: translate(-10px, -10px) !important; /* X轴向左-10px, Y轴向上-10px */\n  margin: 0 !important;","reactionEmojis":["❤️","😂","😮","😢","😡","👍","🔥"],"ltAllowSongChange":true,"ltSongChangeMode":"free","partnerAvatarRef":311,"chatBackgroundRef":312,"_rev":1790950593600},{"userId":"uid_1775656698788_bqsi803tt","characterId":"343b96ba-1527-40fc-a99e-7490dc509146","quickReplyAiEnabled":false,"quickReplyAiCount":3,"quickReplyAiDirections":["推劇情","談心","轉移話題"],"quickReplyAiGuidances":["","",""],"quickReplyAiMode":"combined","quickReplyAiAutoTrigger":true,"quickReplyAiNarration":false,"bubbleStyle":"#ff8c82","partnerBubbleStyle":"#efefef","bubbleTextColor":"","partnerBubbleTextColor":"","chatBackground":"#ffffff","nickname":"艾因","contextDepthIgnoreSummary":true,"crossContextDepth":10,"userLanguage":"Mandarin (Simplified)","timeMode":"real","customTimeFlow":"flow","customAnchorRealMs":null,"customAnchorVirtualMs":null,"voiceEnabled":true,"autoVoice":true,"voiceProvider":"","minimaxTimbreId":"Ayn1121615","minimaxModel":"","fishVolume":null,"fishLatencyBalanced":null,"elevenStability":null,"elevenSimilarityBoost":null,"elevenStyle":null,"elevenSpeakerBoost":null,"themeStyle":"instagram","showBubbleStatus":true,"replyQuoteUseUserName":false,"pinnedModelEnabled":false,"pinne