order: none !important;\n}\n\n/* --- 2. 奶油天平：文字上移 + 缩小 Emoji --- */\n.xt-bar {\n  margin: 15px 40px !important;\n  overflow: visible !important;\n  position: relative !important;\n}\n.xt-bar-label, .xt-bar-value {\n  position: absolute !important;\n  top: -24px !important;\n  font-size: 13px !important;\n  color: #b0a0a0 !important;\n  font-weight: bold !important;\n}\n.xt-bar-label { left: 0 !important; }\n.xt-bar-value { right: 0 !important; }\n\n.xt-bar-track { background: #f5f5f5 !important; height: 10px !important; border-radius: 10px !important; border: 2px solid #fff !important; }\n.xt-bar-fill {\n  background: linear-gradient(90deg, #a2d2ff 0%, #ffafbd 100%) !important;\n  height: 100% !important; border-radius: 10px !important;\n  box-shadow: 0 0 10px rgba(255, 175, 189, 0.3) !important;\n}\n\n.xt-bar::before { content: \"👼\"; position: absolute; left: -32px; top: -3px; font-size: 20px !important; }\n.xt-bar::after { content: \"👿\"; position: absolute; right: -32px; top: -3px; font-size: 20px !important; }\n\n/* --- 3. 灵动飘落核心：彻底打乱下落节奏 --- */\n@keyframes wings-fall-organic {\n  0% { transform: translateY(-10vh) rotate(0deg) translateX(0); opacity: 0; }\n  10% { opacity: 0.5; }\n  30% { transform: translateY(30vh) rotate(40deg) translateX(25px); }\n  60% { transform: translateY(60vh) rotate(-30deg) translateX(-20px); }\n  100% { transform: translateY(105vh) rotate(0deg) translateX(0); opacity: 0; }\n}\n\n.xt-particles-stars .xt-particle {\n  background: transparent !important;\n  font-size: 20px !important;\n  animation: wings-fall-organic 12s linear infinite !important; /* 加慢下落总时长 */\n  box-shadow: none !important; width: auto !important; height: auto !important;\n  position: absolute !important;\n}\n\n/* 核心：通过 nth-child 暴力手动分配下落延迟，确保“断断续续” */\n.xt-particle:nth-child(1) { left: 15%; animation-delay: 0s; }\n.xt-particle:nth-child(2) { left: 80%; animation-delay: -3s; animation-duration: 14s !important; }\n.xt-particle:nth-child(3) { left: 45%; animation-delay: -7s; }\n.xt-particle:nth-child(4) { left: 10%; animation-delay: -2s; animation-duration: 11s !important; }\n.xt-particle:nth-child(5) { left: 90%; animation-delay: -10s; }\n.xt-particle:nth-child(6) { left: 30%; animation-delay: -5s; animation-duration: 15s !important; }\n.xt-particle:nth-child(7) { left: 70%; animation-delay: -1s; }\n.xt-particle:nth-child(8) { left: 55%; animation-delay: -8s; animation-duration: 13s !important; }\n.xt-particle:nth-child(9) { left: 25%; animation-delay: -4s; }\n.xt-particle:nth-child(10) { left: 85%; animation-delay: -12s; }\n\n/* 翅膀和角的样式 */\n.xt-particle:nth-child(odd)::before { content: \"ʚɞ\"; color: #c2e9fb; opacity: 0.7; }\n.xt-particle:nth-child(even)::before { content: \"ψ\"; color: #ffb7c5; opacity: 0.7; }\n\n/* --- 4. 卡片美化 --- */\n.xt-card {\n  background: #fff !important;\n  border-radius: 15px !important;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.02) !important;\n  margin-top: 10px !important;\n}\n.xt-card-title { font-size: 13px !important; font-weight: bold !important; padding-top: 10px !important; }\n.angel-card .xt-card-title { color: #90caf9 !important; }\n.demon-card .xt-card-title { color: #ef9a9a !important; }\n\n.fake-box .xt-section-body, .true-box .xt-section-body {\n  background: #fff !important; border-radius: 12px !important;\n  padding: 15px !important; border: 1px solid #fcf2f2 !important;\n}\n.true-box .xt-section-body { border: 2px dashed #ffb7c5 !important; color: #ff8fa3 !important; }","xinshengCustomPrompt":"在每次回复最末尾追加以下 JSON，不得在对话中提及：\n{\"t\":\"xinsheng\",\"alignment\":随机0-100,\"angelName\":\"天使小名\",\"demonName\":\"恶魔小名\",\"angelThought\":\"天使的心声内容\",\"demonThought\":\"恶魔的心声内容\",\"chat1\":\"(天使说的话)\",\"chat2\":\"(恶魔回的话)\",\"chat3\":\"(天使反驳)\",\"chat4\":\"(恶魔吐槽)\",\"chat5\":\"(天使总结)\",\"fakeReaction\":\"角色表面心声的反应（30字以上）\",\"trueReaction\":\"角色内心真实的强烈反应（❗必须80字以上！将隐秘心声、真实欲望、脑内幻想融合在一起写❗）\"}","xinshengDisplayMode":"layout","xinshengLayout":"# 👼👿 脑内法庭 v19 灵动飘落版\n@particles stars 30\n\n@header charImage cha