}\n.xt-bar-label, .xt-bar-value {\n  position: absolute !important;\n  top: -24px !important;\n  font-size: 13px !important;\n  color: #b0a0a0 !important;\n  font-weight: bold !important;\n}\n.xt-bar-label { left: 0 !important; }\n.xt-bar-value { right: 0 !important; }\n\n.xt-bar-track { background: #f5f5f5 !important; height: 10px !important; border-radius: 10px !important; border: 2px solid #fff !important; }\n.xt-bar-fill {\n  background: linear-gradient(90deg, #a2d2ff 0%, #ffafbd 100%) !important;\n  height: 100% !important; border-radius: 10px !important;\n  box-shadow: 0 0 10px rgba(255, 175, 189, 0.3) !important;\n}\n\n.xt-bar::before { content: \"👼\"; position: absolute; left: -32px; top: -3px; font-size: 20px !important; }\n.xt-bar::after { content: \"👿\"; position: absolute; right: -32px; top: -3px; font-size: 20px !important; }\n\n/* --- 3. 灵动飘落核心：彻底打乱下落节奏 --- */\n@keyframes wings-fall-organic {\n  0% { transform: translateY(-10vh) rotate(0deg) translateX(0); opacity: 0; }\n  10% { opacity: 0.5; }\n  30% { transform: translateY(30vh) rotate(40deg) translateX(25px); }\n  60% { transform: translateY(60vh) rotate(-30deg) translateX(-20px); }\n  100% { transform: translateY(105vh) rotate(0deg) translateX(0); opacity: 0; }\n}\n\n.xt-particles-stars .xt-particle {\n  background: transparent !important;\n  font-size: 20px !important;\n  animation: wings-fall-organic 12s linear infinite !important; /* 加慢下落总时长 */\n  box-shadow: none !important; width: auto !important; height: auto !important;\n  position: absolute !important;\n}\n\n/* 核心：通过 nth-child 暴力手动分配下落延迟，确保“断断续续” */\n.xt-particle:nth-child(1) { left: 15%; animation-delay: 0s; }\n.xt-particle:nth-child(2) { left: 80%; animation-delay: -3s; animation-duration: 14s !important; }\n.xt-particle:nth-child(3) { left: 45%; animation-delay: -7s; }\n.xt-particle:nth-child(4) { left: 10%; animation-delay: -2s; animation-duration: 11s !important; }\n.xt-particle:nth-child(5) { left: 90%; animation-delay: -10s; }\n.xt-p