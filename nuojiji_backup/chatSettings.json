\n  font-size: 12.5px; line-height: 1.75;\n  color: #18191a;\n  margin: 0 !important;\n}\n.xt-text-bili_mycmt::before {\n  content: \"我的评论\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2px;\n  color: #00a1d6;\n  margin-bottom: 4px;\n}\n/* ===== 第7段 · 小红书 ===== */\n.xt-text-xh_title {\n  padding: 14px 16px 12px;\n  background: #f9fafc;\n  border: 1px solid #ff3055;\n  border-bottom: none;\n  border-radius: 14px 14px 0 0;\n  font-size: 14px; font-weight: 700;\n  color: #ff3055;\n  line-height: 1.6;\n  margin: 0 !important;\n}\n.xt-text-xh_rest {\n  padding: 12px 16px 12px;\n  background: #f9fafc;\n  border: 1px solid #ff3055;\n  border-top: none;\n  border-bottom: none;\n  border-radius: 0;\n  font-size: 13px; line-height: 2;\n  color: #18191a;\n  margin: 0 !important;\n}\n.xt-text-xh_mycmt {\n  padding: 8px 12px 10px;\n  background: #fdf0f3;\n  border: 1px solid #ff3055;\n  border-top: none;\n  border-radius: 0 0 14px 14px;\n  font-size: 12.5px; line-height: 1.75;\n  color: #18191a;\n  margin: 0 !important;\n}\n.xt-text-xh_mycmt::before {\n  content: \"我的评论\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2px;\n  color: #ff3055;\n  margin-bottom: 4px;\n}\n/* ===== 第8段 · 游戏+相册 ===== */\n.xt-text-game {\n  position: relative;\n  padding: 14px 16px 30px;\n  background: linear-gradient(135deg, #241f3d, #151226);\n  border: 1px solid rgba(139,124,240,0.4);\n  border-left: 3px solid #8b7cf0;\n  border-radius: 14px;\n  font-size: 13.5px; line-height: 2;\n  color: #f5f5f3;\n}\n.xt-text-game::first-line {\n  color: #b8a8ff;\n  font-weight: 700;\n}\n.xt-text-game::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 4px;\n  background: linear-gradient(90deg, #8b7cf0, rgba(139,124,240,0.2));\n  border-radius: 12px 12px 0 0;\n}\n.xt-text-game::after {\n  content: \"\";\n  position: absolute;\n  left: 16px; right: 16px; bottom: 10px;\n  height: 5px;\n  border-radius: 3px;\n  background: linear-gradient(90deg, #8b7cf0 0 70%, rgba(255,255,255,0.08) 70% 100%);\n}\n.xt-text-album_1,\n.xt-text-album_2,\n.xt-text-album_3 {\n  position: relative;\n  padding: 14px 16px;\n  background: linear-gradient(160deg, #1c1c20, #131316);\n  border: 1px solid rgba(255,255,255,0.07);\n  border-radius: 16px;\n  font-size: 13.5px; line-height: 2;\n  color: rgba(245,245,243,0.85);\n  margin-bottom: 10px;\n  box-shadow: inset 0 2px 3px rgba(0,0,0,0.4);\n}\n.xt-text-album_1::first-line,\n.xt-text-album_2::first-line,\n.xt-text-album_3::first-line {\n  font-size: 11px;\n  color: rgba(201,168,106,0.7);\n}\n/* ===== 第9段 · 位置/外卖/物流 ===== */\n.xt-text-location {\n  position: relative;\n  padding: 12px 14px 12px 34px;\n  background:\n    linear-gradient(rgba(16,185,129,0.06) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(16,185,129,0.06) 1px, transparent 1px),\n    #101d18;\n  background-size: 20px 20px;\n  border: 1px solid rgba(16,185,129,0.25);\n  border-left: 3px solid #10b981;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 1.9;\n  color: rgba(245,245,243,0.85);\n}\n.xt-text-order {\n  background: linear-gradient(135deg, #2a2410, #1a1a14);\n  border: 1px solid rgba(255,209,0,0.2);\n  border-top: 3px solid #ffd100;\n  border-radius: 12px;\n  padding: 12px 14px;\n  font-size: 13.5px; line-height: 2;\n  color: rgba(245,245,243,0.85);\n}\n.xt-text-order::first-line {\n  color: #ffd100;\n  font-weight: 700;\n}\n.xt-text-delivery {\n  position: relative;\n  padding: 12px 14px;\n  background: linear-gradient(135deg, #2a1a10, #1a1510);\n  border: 1px solid rgba(255,102,0,0.25);\n  border-left: 3px solid #ff6600;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 2;\n  color: #f5f5f3;\n}\n.xt-text-delivery::first-line {\n  color: #ff6600;\n  font-weight: 700;\n}\n.xt-text-delivery::after {\n  content: \"\";\n  display: block;\n  height: 4px;\n  border-radius: 2px;\n  margin-top: 10px;\n  background: linear-gradient(90deg, #ff6600 0 65%, rgba(255,255,255,0.1) 65% 100%);\n}\n/* ===== 第10段 · 钱包/账单/健康/日程/闹钟 ===== */\n.xt-text-wallet_app {\n  position: relative;\n  padding: 46px 18px 16px;\n  border-radius: 16px;\n  background: linear-gradient(135deg, #0e3a66, #1677ff);\n  border: 1px solid rgba(22,119,255,0.5);\n  box-shadow: 0 8px 24px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.15);\n  font-size: 14px; line-height: 2;\n  color: #f5f7fa; letter-spacing: 0.3px;\n  margin-bottom: 8px;\n}\n.xt-text-bills_expense {\n  padding: 12px 14px;\n  background: #0d2b4d;\n  border: 1px solid rgba(22,119,255,0.3);\n  border-radius: 12px;\n  font-size: 13px; line-height: 2;\n  color: rgba(255,255,255,0.9);\n  margin-bottom: 8px;\n}\n.xt-text-bills_expense::before {\n  content: \"支出\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2.4px;\n  color: #6db3ff;\n  margin-bottom: 6px;\n}\n.xt-text-bills_income {\n  padding: 12px 14px;\n  background: #0d2b1e;\n  border: 1px solid rgba(34,197,94,0.3);\n  border-radius: 12px;\n  font-size: 13px; line-height: 2;\n  color: rgba(255,255,255,0.9);\n}\n.xt-text-bills_income::before {\n  content: \"收入\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2.4px;\n  color: #4ade80;\n  margin-bottom: 6px;\n}\n.xt-row { display: flex; gap: 10px; }\n.xt-row > * { flex: 1; }\n.xt-ring { margin-bottom: 6px; }\n.xt-ring-fill { stroke: #c9a86a; }\n.xt-ring-value { color: #f5f5f3; font-weight: 700; }\n.xt-ring-label { color: rgba(245,245,243,0.6); }\n.xt-text-health_steps {\n  padding: 10px 14px;\n  background: #10231a;\n  border: 1px solid rgba(34,197,94,0.2);\n  border-left: 3px solid #22c55e;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 1.9;\n  color: rgba(245,245,243,0.85);\n  margin-top: 10px;\n}\n.xt-text-health_sleep {\n  padding: 10px 14px;\n  background: #10231a;\n  border: 1px solid rgba(34,197,94,0.2);\n  border-left: 3px solid #22c55e;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 1.9;\n  color: rgba(245,245,243,0.85);\n  margin-top: 8px;\n}\n/* 日程与待办：行距加大，一条一行 */\n.xt-text-calendar_note {\n  padding: 10px 14px 10px 16px;\n  background: #1e1e22;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 2.3;\n  color: rgba(245,245,243,0.75);\n}\n.xt-text-alarm {\n  padding: 12px 14px;\n  background: #211d16;\n  border: 1px solid rgba(201,168,106,0.18);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 2.1;\n  color: #f5f5f3;\n}\n/* ===== 第11段 · 微信 ===== */\n.xt-text-chat_a_title,\n.xt-text-chat_b_title,\n.xt-text-chat_g_title {\n  text-align: center;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  color: #f5f5f3;\n  padding: 4px 0 10px;\n  margin-bottom: 10px;\n  border-bottom: 1px solid rgba(7,193,96,0.35);\n}\n.xt-bubble,\n.xt-bubble-left,\n.xt-bubble-right,\n.xt-bubble-body {\n  background: transparent !important;\n  border: none !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n}\n.xt-bubbles {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n}\n.xt-bubble-left {\n  align-self: flex-start;\n  max-width: 82%;\n  background: #2a2a30 !important;\n  border-radius: 12px 12px 12px 4px !important;\n  padding: 7px 11px;\n  font-size: 12.5px; line-height: 1.65;\n  color: #f5f5f3 !important;\n}\n.xt-bubble-right {\n  align-self: flex-end;\n  max-width: 82%;\n  background: linear-gradient(135deg, #07c160, #06a04f) !important;\n  border-radius: 12px 12px 4px 12px !important;\n  padding: 7px 11px;\n  font-size: 12.5px; line-height: 1.65;\n  color: #ffffff !important;\n}\n/* ===== 第12段 · 通话/收藏/好友 ===== */\n.xt-text-call {\n  position: relative;\n  padding: 10px 12px 10px 14px;\n  background: #1e1e22;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 12px; line-height: 1.9;\n  color: rgba(245,245,243,0.8);\n}\n.xt-text-call::first-line {\n  color: #c9a86a;\n  font-weight: 700;\n}\n.xt-text-call::after {\n  content: \"\";\n  position: absolute;\n  right: 12px; top: 14px;\n  width: 7px; height: 7px;\n  border-radius: 50%;\n  background: #e74c3c;\n  box-shadow: 0 0 4px rgba(231,76,60,0.5);\n}\n.xt-text-fav {\n  position: relative;\n  padding: 10px 14px 10px 34px;\n  background: #211f1b;\n  border: 1px solid rgba(201,168,106,0.15);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 2;\n  color: rgba(245,245,243,0.8);\n}\n.xt-text-fav::before {\n  content: \"★\";\n  position: absolute;\n  left: 13px; top: 50%;\n  transform: translateY(-50%);\n  color: #e6b46a;\n  font-size: 15px;\n}\n.xt-text-p1avt, .xt-text-p2avt {\n  display: inline-block;\n  width: 40px; height: 40px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #323238, #242428);\n  border: 1px solid rgba(201,168,106,0.5);\n  font-size: 21px; line-height: 40px;\n  text-align: center; vertical-align: top;\n  margin: 4px 8px 4px 0;\n  padding: 0;\n}\n.xt-text-p1info, .xt-text-p2info {\n  display: inline-block;\n  padding: 9px 12px;\n  background: #1e1e22;\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 10px;\n  font-size: 14px; font-weight: 700;\n  color: #f5f5f3;\n  vertical-align: top; line-height: 1.4;\n}\n.xt-text-p1body, .xt-text-p2body {\n  padding: 12px 0;\n  font-size: 14px; line-height: 1.75;\n  color: rgba(245,245,243,0.8);\n  border-bottom: 1px solid rgba(255,255,255,0.07);\n}\n.xt-text-p1cmt, .xt-text-p2cmt {\n  padding: 10px 0 2px;\n  font-size: 12.5px; line-height: 2.1;\n  color: rgba(245,245,243,0.55);\n  border-top: 2px solid rgba(201,168,106,0.4);\n  margin-top: 8px;\n}\n/* ===== 第13段 · 投票/热搜/搜索/引用/推荐 ===== */\n.xt-text-pollq {\n  padding: 10px 14px 10px 16px;\n  background: #1e1e22;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 15px; font-weight: 700;\n  color: #f5f5f3;\n}\n.xt-text-pollopt {\n  position: relative;\n  padding: 10px 14px 10px 34px;\n  background: #1e1e22;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 14px; line-height: 2.2;\n  color: rgba(245,245,243,0.75);\n}\n.xt-text-pollopt::before {\n  content: \"\";\n  position: absolute;\n  left: 14px; top: 50%;\n  transform: translateY(-50%);\n  width: 12px; height: 12px;\n  border-radius: 50%;\n  border: 2px solid rgba(201,168,106,0.5);\n  background: radial-gradient(circle, #c9a86a 0 40%, transparent 45%);\n}\n.xt-text-pollopt::first-line { color: #f5f5f3; font-weight: 700; }\n.xt-text-pollinfo {\n  padding: 8px 14px;\n  background: #1b1b1f;\n  border-radius: 10px;\n  font-size: 12px;\n  color: rgba(245,245,243,0.5);\n}\n.xt-text-trends_hot {\n  padding: 12px 14px 12px 16px;\n  background: linear-gradient(180deg, #201f1c, #1a1916);\n  border: 1px solid rgba(201,168,106,0.12);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 14px; line-height: 2.5;\n  color: rgba(245,245,243,0.85);\n}\n.xt-text-trends_hot::before {\n  content: \"实时热榜\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2.4px;\n  color: #c9a86a;\n  margin-bottom: 8px;\n}\n.xt-text-trends_view {\n  padding: 10px 14px 10px 16px;\n  background: #1b1a18;\n  border: 1px solid rgba(201,168,106,0.15);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 13px; line-height: 1.9;\n  color: rgba(245,245,243,0.85);\n  margin-top: 8px;\n}\n.xt-text-trends_view::before {\n  content: \"我的看法\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2.4px;\n  color: #c9a86a;\n  margin-bottom: 6px;\n}\n.xt-text-history {\n  position: relative;\n  padding: 12px 14px 12px 36px;\n  background: #1c1c20;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 2px dotted rgba(201,168,106,0.6);\n  border-radius: 12px;\n  font-size: 13px; line-height: 2.1;\n  color: rgba(245,245,243,0.55);\n}\n.xt-text-history::before {\n  content: \"\";\n  position: absolute;\n  left: 13px; top: 50%;\n  transform: translateY(-50%);\n  width: 10px; height: 10px;\n  border: 1.5px solid rgba(245,245,243,0.4);\n  border-radius: 50%;\n}\n.xt-text-history::after {\n  content: \"\";\n  position: absolute;\n  left: 22px; top: calc(50% + 4px);\n  width: 6px; height: 1.5px;\n  background: rgba(245,245,243,0.4);\n  transform: rotate(45deg);\n}\n.xt-quote {\n  position: relative;\n  padding: 14px 16px 14px 22px;\n  background: linear-gradient(135deg, #232018, #1f1c16);\n  border: 1px solid rgba(201,168,106,0.22);\n  border-radius: 12px;\n  font-size: 14px; line-height: 1.9;\n  color: #f5f5f3;\n  font-style: italic;\n}\n.xt-text-recommend_reminder {\n  padding: 10px 14px 10px 16px;\n  background: #1e1e22;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 2.1;\n  color: rgba(245,245,243,0.75);\n}\n/* ===== 第14段 · 微信读书+备忘录 ===== */\n.xt-text-reading_title {\n  padding: 14px 16px;\n  background: linear-gradient(135deg, #0f1f18, #12161a);\n  border: 1px solid rgba(46,175,79,0.25);\n  border-left: 3px solid #2eaf4f;\n  border-bottom: none;\n  border-radius: 14px 14px 0 0;\n  font-size: 14px; font-weight: 700;\n  color: #4ade80;\n  margin: 0 !important;\n}\n.xt-text-reading_quote {\n  padding: 10px 16px;\n  background: #0e1f17;\n  border: 1px solid rgba(46,175,79,0.25);\n  border-top: none;\n  border-left: 3px solid #2eaf4f;\n  border-radius: 0;\n  font-style: italic;\n  font-size: 13px; line-height: 1.9;\n  color: #a7f3d0;\n  margin: 0 !important;\n}\n.xt-text-reading_note {\n  padding: 10px 16px 14px;\n  background: #12161a;\n  border: 1px solid rgba(46,175,79,0.25);\n  border-top: none;\n  border-radius: 0 0 14px 14px;\n  font-size: 13px; line-height: 1.9;\n  color: rgba(245,245,243,0.85);\n  margin: 0 !important;\n}\n.xt-text-reading_note::before {\n  content: \"我的笔记\";\n  display: block;\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 2px;\n  color: #4ade80;\n  margin-bottom: 6px;\n}\n.xt-text-letter {\n  position: relative;\n  padding: 46px 18px 32px;\n  background-color: #fbf7ec;\n  background-image:\n    linear-gradient(180deg, rgba(255,255,255,0.6), transparent 30%),\n    linear-gradient(180deg, transparent, rgba(210,190,150,0.15));\n  border: 1px solid rgba(200,180,140,0.5);\n  border-radius: 18px;\n  box-shadow:\n    0 14px 36px rgba(0,0,0,0.55),\n    inset 0 1px 0 rgba(255,255,255,0.8),\n    inset 0 0 60px rgba(230,215,180,0.2);\n  font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", sans-serif;\n  font-size: 15px;\n  line-height: 1.9;\n  letter-spacing: 0.3px;\n  color: #3a3428;\n  white-space: pre-wrap;\n}\n.xt-text-letter::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 32px;\n  background:\n    radial-gradient(circle 3px at 16px 16px, rgba(120,100,70,0.35), transparent),\n    radial-gradient(circle 3px at 28px 16px, rgba(120,100,70,0.35), transparent),\n    radial-gradient(circle 3px at 40px 16px, rgba(120,100,70,0.35), transparent),\n    linear-gradient(180deg, #f0e9d6, #e4dbc2);\n  border-radius: 18px 18px 0 0;\n  border-bottom: 1px solid rgba(200,180,140,0.35);\n}\n.xt-text-letter::after {\n  content: \"\";\n  position: absolute;\n  left: 18px; right: 18px; bottom: 14px;\n  height: 1px;\n  background: linear-gradient(90deg, rgba(180,160,120,0.5), transparent 70%);\n}\n/* ===== 第15段 · 系统区 ===== */\n.xt-text-screentime {\n  padding: 12px 14px;\n  background: #1c1e22;\n  border: 1px solid rgba(255,255,255,0.07);\n  border-left: 3px solid #c9a86a;\n  border-radius: 12px;\n  font-size: 13.5px; line-height: 2.1;\n  color: rgba(245,245,243,0.8);\n}\n.xt-text-sms_1 {\n  align-self: flex-start;\n  max-width: 88%;\n  background: #1e3a2e;\n  border-radius: 14px 14px 14px 4px;\n  padding: 9px 13px;\n  font-size: 13px; line-height: 1.75;\n  color: #f0f5f1;\n  margin: 4px 0 10px;\n}\n