nt; }\n.xt-card-title {\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  color: #555555 !important;\n  letter-spacing: 1.2px !important;\n  text-transform: uppercase !important;\n  padding: 11px 14px 2px !important;\n  margin: 0 !important;\n  display: block !important;\n}\n\n/* ══════════════════════\n   最近搜索区\n   设计：带标题的独立白卡\n   四行搜索词 + 展开心声\n══════════════════════ */\n\n/* 四个搜索词共同外包一个白卡效果\n   用 search1 第一行的 ::before 做卡片标题 */\n.xt-text-search1 {\n  margin-top: 0 !important;\n  border-radius: 16px 16px 0 0 !important;\n  border-bottom: 1px solid #212121 !important;\n  padding-top: 10px !important;\n}\n.xt-text-search1::before {\n  content: \"🔍  最近搜索\" !important;\n  display: block !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  color: #555555 !important;\n  letter-spacing: 1.2px !important;\n  text-transform: uppercase !important;\n  margin-bottom: 8px !important;\n  padding: 0 !important;\n}\n\n/* 四个搜索词的共同样式 */\n.xt-text-search1,\n.xt-text-search2,\n.xt-text-search3,\n.xt-text-search4 {\n  display: block !important;\n  background: #1a1a1a !important;\n  border-left: 1.5px solid #2a2a2a !important;\n  border-right: 1.5px solid #2a2a2a !important;\n  border-top: none !important;\n  border-bottom: 1px solid #212121 !important;\n  border-radius: 0 !important;\n  padding: 11px 40px 11px 16px !important;\n  margin: 0 !important;\n  font-size: 13.5px !important;\n  font-weight: 400 !important;\n  color: #e0e0e0 !important;\n  font-style: normal !important;\n  cursor: pointer !important;\n  position: relative !important;\n  transition: background 0.15s !important;\n}\n/* 左侧搜索图标 */\n.xt-text-search1::after,\n.xt-text-search2::after,\n.xt-text-search3::after,\n.xt-text-search4::after {\n  content: \"›\" !important;\n  position: absolute !important;\n  right: 15px !important;\n  top: 50% !important;\n  transform: translateY(-50%) !important;\n  font-size: 20px !important;\n  color: #444444 !important;\n  line-height: 1 !important;\n  transition: color 0.15s, transform 0.2s !important;\n  font-style: normal !important;\n}\n/* 最后一行圆角收尾（无心声展开时） */\n.xt-text-search4 {\n  border-radius: 0 0 16px 16px !important;\n  border-bottom: 1.5px solid #2a2a2a !important;\n  margin-bottom: 10px !important;\n}\n/* 展开时最后一行取消圆角，由OS气泡接管 */\n#xt-t4:checked ~ .xt-content .xt-text-search4 {\n  border-radius: 0 !important;\n  border-bottom: 1px solid #212121 !important;\n}\n\n/* 选中状态高亮 */\n#xt-t1:checked ~ .xt-content .xt-text-search1 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t2:checked ~ .xt-content .xt-text-search2 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t3:checked ~ .xt-content .xt-text-search3 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t4:checked ~ .xt-content .xt-text-search4 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t1:checked ~ .xt-content .xt-text-search1::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n#xt-t2:checked ~ .xt-content .xt-text-search2::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n#xt-t3:checked ~ .xt-content .xt-text-search3::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n#xt-t4:checked ~ .xt-content .xt-text-search4::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n\n/* 搜索心声气泡 */\n.xt-text-search1Os,\n.xt-text-search2Os,\n.xt-text-search3Os,\n.xt-text-search4Os {\n  display: block !important;\n  max-height: 0 !important;\n  overflow: hidden !important;\n  background: #181818 !important;\n  border-left: 1.5px solid #2a2a2a !important;\n  border-right: 1.5px solid #2a2a2a !important;\n  border-top: none !important;\n  border-bottom: none !important;\n  border-radius: 0 !important;\n  padding: 0 16px !important;\n  margin: 0 !important;\n  font-size: 12.5px !important;\n  color: #aaaaaa !important;\n  font-style: italic !important;\n  line-height: 1.75 !important;\n  transition: max-height 0.3s ease, padding 0.22s ease !important;\n}\n/* search4的Os展开后需要有底部圆角 */\n.xt-text-search4Os {\n  border-radius: 0 0 16px 16px !important;\n  border-bottom: 1.5px solid #2a2a2a !important;\n  margin-bottom: 10px !important;\n}\n#xt-t1:checked ~ .xt-content .xt-text-search1Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n#xt-t2:checked ~ .xt-content .xt-text-search2Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n#xt-t3:checked ~ .xt-content .xt-text-search3Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n#xt-t4:checked ~ .xt-content .xt-text-search4Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n\n/* 透明按钮覆盖搜索词行 */\n.xt-action-1,.xt-action-2,.xt-action-3,.xt-action-4 {\n  display: block !important;\n  width: 100% !important;\n  height: 44px !important;\n  margin: -44px 0 0 0 !important;\n  background: transparent !important;\n  border: none !important;\n  padding: 0 !important;\n  cursor: pointer !important;\n  position: relative !important;\n  z-index: 5 !important;\n  opacity: 0 !important;\n  font-size: 0 !important;\n}\n.xt-action-1::after,.xt-action-2::after,\n.xt-action-3::after,.xt-action-4::after { content: \"\" !important; }\n\n/* ══════════════════════\n   ROW 两列\n══════════════════════ */\n.xt-row { gap: 9px !important; margin-bottom: 10px !important; align-items: stretch !important; }\n.xt-row > * { margin-bottom: 0 !important; }\n\n/* ── 动物塑 */\n.xt-text-animalType {\n  display: block !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  color: #909090 !important;\n  letter-spacing: 0.8px !important;\n  font-style: normal !important;\n  padding: 5px 13px 2px !important;\n  background: transparent !important;\n  border: none !important;\n  text-transform: uppercase !important;\n}\n.xt-text-animalAct {\n  display: block !important;\n  font-size: 12.5px !impo