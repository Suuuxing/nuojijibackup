    font-weight: 900;\n    color: #cc0000;\n    letter-spacing: 1px;\n    line-height: 1.5;\n}\n/* 标题前面加【】装饰 */\n.xt-section-0 .xt-section-body::before {\n    content: \"【\";\n    color: #cc0000;\n}\n.xt-section-0 .xt-section-body::after {\n    content: \"】\";\n    color: #cc0000;\n}\n\n/* ═══════ 时间戳通用 ═══════ */\n.xt-text {\n    padding: 2px 14px;\n    font-size: 11px;\n    color: #666;\n    background: transparent;\n    border-radius: 0;\n    letter-spacing: 0.5px;\n    font-weight: 700;\n}\n\n/* 第1个时间戳：楼主发帖时间 */\n.xt-text:nth-of-type(1) {\n    padding: 2px 14px 6px;\n    color: #888;\n}\n.xt-text:nth-of-type(1)::before {\n    content: \"发表于 \";\n    font-weight: 400;\n}\n\n/* ═══════ 分隔线 ═══════ */\n.xt-divider {\n    border-top: 1px dashed #bbb !important;\n    background: none !important;\n    height: auto !important;\n    margin: 0 !important;\n}\n\n/* ═══════ section 共用 ═══════ */\n.xt-section {\n    margin: 0;\n    padding: 0;\n    background: transparent;\n    box-shadow: none;\n    border-radius: 0;\n}\n.xt-section-title { display: none; }\n.xt-section-body {\n    background: transparent;\n    border: none !important;\n    padding: 8px 14px 10px;\n    font-size: 13px;\n    line-height: 2;\n    letter-spacing: 0.3px;\n    color: #333;\n}\n\n/* ═══════ 1楼：楼主·现在 ═══════ */\n.xt-section-1 {\n    position: relative;\n    background: #fff;\n}\n.xt-section-1::before {\n    content: \"1楼 · 楼主\";\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    font-size: 10px;\n    color: #fff;\n    background: #cc0000;\n    padding: 2px 10px;\n    font-weight: 900;\n    letter-spacing: 1px;\n    border-radius: 0;\n}\n.xt-section-1 .xt-section-body {\n    color: #222;\n    font-weight: 400;\n    font-size: 14px;\n}\n\n/* ═══════ 2楼：过去 ═══════ */\n.xt-text:nth-of-type(2) {\n    padding: 10px 14px 0;\n    font-size: 13px;\n    color: #0044aa;\n    font-weight: 900;\n    text-decoration: underline;\n}\n.xt-text:nth-of-type(3) {\n    padding: 0 14px 4px;\n    color: #888;\n}\n.xt-text:nth-of-type(3)::before {\n    content: \"发表于 \";\n    font-weight: 400;\n}\n.xt-section-2 {\n    position: relative;\n    background: #f8f8f6;\n}\n.xt-section-2::before {\n    content: \"2楼\";\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    font-size: 10px;\n    color: #888;\n    background: #e8e8e8;\n    padding: 2px 10px;\n    font-weight: 900;\n    letter-spacing: 1px;\n}\n.xt-section-2 .xt-section-body {\n    color: #777;\n    font-style: italic;\n    font-weight: 400;\n    border-left: 3px solid #aab8cc !important;\n    margin: 0 14px;\n    padding: 6px 12px;\n    background: #f0f2f5;\n}\n\n/* ═══════ 3楼：未来 ═══════ */\n.xt-text:nth-of-type(4) {\n    padding: 10px 14px 0;\n    font-size: 13px;\n    color: #6644aa;\n    font-weight: 900;\n    text-decoration: underline;\n}\n.xt-text:nth-of-type(5) {\n    padding: 0 14px 4px;\n    color: #888;\n}\n.xt-text:nth-of-type(5)::before {\n    content: \"发表于 \";\n    font-weight: 400;\n}\n.xt-section-3 {\n    position: relative;\n    background: #fff;\n}\n.xt-section-3::before {\n    content: \"3楼\";\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    font-size: 10px;\n    color: #888;\n    background: #e8e8e8;\n    padding: 2px 10px;\n    font-weight: 900;\n    letter-spacing: 1px;\n}\n.xt-section-3 .xt-section-body {\n    color: #7766aa;\n    font-weight: 400;\n    border-left: 3px solid #c8c0dd !important;\n    margin: 0 14px;\n    padding: 6px 12px;\n    background: #f6f4fa;\n}\n\n/* ═══════ 底部 ═══════ */\n.xt-footer {\n    background: linear-gradient(180deg, #e8edf2 0%, #d0d8e2 100%);\n    border-top: 2px solid #8a8a8a;\n    color: #888;\n    font-size: 10px;\n    letter-spacing: 1px;\n    padding: 8px 14px;\n    text-align: center;\n}","xinshengCustomPrompt":"在每次回复最末尾追加以下 JSON，不得在对话中提及：\n{\"t\":\"xinsheng\",\"charName\":\"{{char}}\",\"nowVoice\":\"基于当前对话的此刻内心独白，贴合当前人设，30-50字\",\"pastVoice\":\"根据角色人设和当前聊天内容推演过去的他的内心独白，语气更青涩或锋利或脆弱，30-50字\",\"futureVoice\":\"根据角色人设和当前聊天内容推演未