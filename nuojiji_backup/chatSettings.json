nfig":{"enabled":true,"enabledBooks":["1776248137616"],"disabledEntries":["emqdp3izt4","emqdp3izt7","emqdp3izt0","emqdp3izt2","emqdp3izta","emqdp3iztb","emqdp3izt3","emqdp3iztc","emqdp3izte","emqdp3izt6","emundtqxt0"]},"wbConfigOffline":{"separate":false},"userAvatarRef":616,"partnerAvatarRef":617,"chatBackgroundRef":313,"_rev":1791469151614},{"userId":"uid_1775656698788_bqsi803tt","characterId":"6535670e-b3dc-414e-a3c7-a4a0b1523991","quickReplyAiEnabled":false,"quickReplyAiCount":3,"quickReplyAiDirections":["推劇情","談心","轉移話題"],"quickReplyAiGuidances":["","",""],"quickReplyAiMode":"combined","quickReplyAiAutoTrigger":true,"bubbleStyle":"premium-gradient","partnerBubbleStyle":"#efefef","bubbleTextColor":"","partnerBubbleTextColor":"","chatBackground":"#ffffff","nickname":"魈","contextDepthIgnoreSummary":true,"crossContextDepth":10,"userLanguage":"Mandarin (Simplified)","timeMode":"real","customTimeFlow":"flow","customAnchorRealMs":null,"customAnchorVirtualMs":null,"minimaxModel":"","elevenStability":null,"elevenSimilarityBoost":null,"elevenStyle":null,"elevenSpeakerBoost":null,"themeStyle":"qq","showBubbleStatus":true,"pinnedModelEnabled":false,"pinnedApiUrl":"","pinnedApiKey":"","pinnedModel":"","pinnedTemperatureEnabled":false,"pinnedTemperature":0.7,"personalStickersOnly":false,"useUserStickerLib":false,"stealUserStickers":false,"bannerMuted":true,"bubbleFontSize":15,"avatarSize":40,"avatarShape":"circle","imagePreset":null,"patEnabled":true,"patUserPool":[],"patCharPool":[],"patCharImprovise":true,"autoBigSummaryEvery":0,"xinshengCustomCss":"@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap');\n\n/* ══════════════════════\n   ROOT\n══════════════════════ */\n.xt-root {\n  --xt-bg:         #0f0f0f;\n  --xt-text:       #e0e0e0;\n  --xt-text-sub:   #888888;\n  --xt-text-muted: #555555;\n  --xt-accent:     #909090;\n  --xt-accent-bg:  rgba(255,255,255,0.05);\n  --xt-border:     #2e2e2e;\n  --xt-radius:     18px;\n  --xt-radius-sm:  11px;\n  --xt-font:       'Noto Sans SC','PingFang SC','Hiragino Sans GB',sans-serif;\n  --xt-anim-duration: 0.28s;\n  --pink:          #888888;\n  --pink-bg:       #1f1f1f;\n  --pink-border:   #3a3a3a;\n  --pink-text:     #bbbbbb;\n  background: var(--xt-bg);\n  padding: 0;\n  font-size: 13px;\n  line-height: 1.5;\n}\n.xt-content { padding: 14px 13px 14px; }\n\n/* ══════════════════════\n   CARD 通用\n══════════════════════ */\n.xt-card {\n  background: #1a1a1a !important;\n  border: 1.5px solid #2a2a2a !important;\n  border-radius: 16px !important;\n  padding: 0 !important;\n  margin-bottom: 10px !important;\n  box-shadow: 0 2px 12px rgba(255,255,255,0.03) !important;\n  overflow: hidden !important;\n}\n.xt-card:hover { box-shadow: 0 4px 18px rgba(255,255,255,0.08) !important; transform: none !important; }\n.xt-card-title {\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  color: #555555 !important;\n  letter-spacing: 1.2px !important;\n  text-transform: uppercase !important;\n  padding: 11px 14px 2px !important;\n  margin: 0 !important;\n  display: block !important;\n}\n\n/* ══════════════════════\n   最近搜索区\n   设计：带标题的独立白卡\n   四行搜索词 + 展开心声\n══════════════════════ */\n\n/* 四个搜索词共同外包一个白卡效果\n   用 search1 第一行的 ::before 做卡片标题 */\n.xt-text-search1 {\n  margin-top: 0 !important;\n  border-radius: 16px 16px 0 0 !important;\n  border-bottom: 1px solid #212121 !important;\n  padding-top: 10px !important;\n}\n.xt-text-search1::before {\n  content: \"🔍  最近搜索\" !important;\n  display: block !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  color: #555555 !important;\n  letter-spacing: 1.2px !important;\n  text-transform: uppercase !important;\n  margin-bottom: 8px !important;\n  padding: 0 !important;\n}\n\n/* 四个搜索词的共同样式 */\n.xt-text-search1,\n.xt-text-search2,\n.xt-text-search3,\n.xt-text-search4 {\n  display: block !important;\n  background: #1a1a1a !important;\n  border-left: 1.5px solid #2a2a2a !important;\n  border-right: 1.5px solid #2a2a2a !important;\n  border-top: none !important;\n  border-bottom: 1px solid #212121 !important;\n  border-radius: 0 !important;\n  padding: 11px 40px 11px 16px !important;\n  margin: 0 !important;\n  font-size: 13.5px !important;\n  font-weight: 400 !important;\n  color: #e0e0e0 !important;\n  font-style: normal !important;\n  cursor: pointer !important;\n  position: relative !important;\n  transition: background 0.15s !important;\n}\n/* 左侧搜索图标 */\n.xt-text-search1::after,\n.xt-text-search2::after,\n.xt-text-search3::after,\n.xt-text-search4::after {\n  content: \"›\" !important;\n  position: absolute !important;\n  right: 15px !important;\n  top: 50% !important;\n  transform: translateY(-50%) !important;\n  font-size: 20px !important;\n  color: #444444 !important;\n  line-height: 1 !important;\n  transition: color 0.15s, transform 0.2s !important;\n  font-style: normal !important;\n}\n/* 最后一行圆角收尾（无心声展开时） */\n.xt-text-search4 {\n  border-radius: 0 0 16px 16px !important;\n  border-bottom: 1.5px solid #2a2a2a !important;\n  margin-bottom: 10px !important;\n}\n/* 展开时最后一行取消圆角，由OS气泡接管 */\n#xt-t4:checked ~ .xt-content .xt-text-search4 {\n  border-radius: 0 !important;\n  border-bottom: 1px solid #212121 !important;\n}\n\n/* 选中状态高亮 */\n#xt-t1:checked ~ .xt-content .xt-text-search1 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t2:checked ~ .xt-content .xt-text-search2 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t3:checked ~ .xt-content .xt-text-search3 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t4:checked ~ .xt-content .xt-text-search4 { background: #1f1f1f !important; color: #eeeeee !important; }\n#xt-t1:checked ~ .xt-content .xt-text-search1::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n#xt-t2:checked ~ .xt-content .xt-text-search2::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n#xt-t3:checked ~ .xt-content .xt-text-search3::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n#xt-t4:checked ~ .xt-content .xt-text-search4::after { color: #909090 !important; transform: translateY(-50%) rotate(90deg) !important; }\n\n/* 搜索心声气泡 */\n.xt-text-search1Os,\n.xt-text-search2Os,\n.xt-text-search3Os,\n.xt-text-search4Os {\n  display: block !important;\n  max-height: 0 !important;\n  overflow: hidden !important;\n  background: #181818 !important;\n  border-left: 1.5px solid #2a2a2a !important;\n  border-right: 1.5px solid #2a2a2a !important;\n  border-top: none !important;\n  border-bottom: none !important;\n  border-radius: 0 !important;\n  padding: 0 16px !important;\n  margin: 0 !important;\n  font-size: 12.5px !important;\n  color: #aaaaaa !important;\n  font-style: italic !important;\n  line-height: 1.75 !important;\n  transition: max-height 0.3s ease, padding 0.22s ease !important;\n}\n/* search4的Os展开后需要有底部圆角 */\n.xt-text-search4Os {\n  border-radius: 0 0 16px 16px !important;\n  border-bottom: 1.5px solid #2a2a2a !important;\n  margin-bottom: 10px !important;\n}\n#xt-t1:checked ~ .xt-content .xt-text-search1Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n#xt-t2:checked ~ .xt-content .xt-text-search2Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n#xt-t3:checked ~ .xt-content .xt-text-search3Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n#xt-t4:checked ~ .xt-content .xt-text-search4Os { max-height: 100px !important; padding: 10px 16px 12px !important; }\n\n/* 透明按钮覆盖搜索词行 */\n.xt-action-1,.xt-action-2,.xt-action-3,.xt-action-4 {\n  display: block !important;\n  width: 100% !important;\n  height: 44px !important;\n  margin: -44px 0 0 0 !important;\n  background: transparent !important;\n  border: none !important;\n  padding: 0 !important;\n  cursor: pointer !important;\n  position: relative !important;\n  z-index: 5 !important;\n  opacity: 0 !important;\n  font-size: 0 !important;\n}\n.xt-action-1::after,.xt-action-2::after,\n.xt-action-3::after,.xt-action-4::after { content: \"\" !important; }\n\n/* ══════════════════════\n   ROW 两列\n══════════════════════ */\n.xt-row { gap: 9px !important; margin-bottom: 10px !important; align-items: stretch !important; }\n.xt-row > * { margin-bottom: 0 !important; }\n\n/* ── 动物塑 */\n.xt-text-animalType {\n  display: block !important;\n  font-size: 10px !important;\n  font-weight: 700 !important;\n  color: #909090 !important;\n  letter-spacing: 0.8px !important;\n  font-style: normal !important;\n  padding: 5px 13px 2px !important;\n  background: transparent !important;\n  border: none !important;\n  text-transform: uppercase !important;\n}\n.xt-text-animalAct {\n  display: block !important;\n  font-size: 12.5px !important;\n  color: #e0e0e0 !important;\n  font-style: normal !important;\n  line-height: 1.8 !important;\n  padding: 0 13px 13px !important;\n  background: transparent !important;\n  border: none !important;\n}\n\n/* ── 待办 */\n.xt-list { background: transparent !important; padding: 5px 0 8px !important; margin: 0 !important; border-radius: 0 !important; }\n.xt-list-item {\n  display: flex !important; align-items: center !important; gap: 9px !important;\n  font-size: 12.5px !important; color: #e0e0e0 !important;\n  padding: 7px 14px !important;\n  border-bottom: 1px solid #212121 !important;\n  line-height: 1.4 !important;\n}\n.xt-list-item:last-child { border-bottom: none !important; }\n.xt-list-check {\n  width: 15px !important; height: 15px !important;\n  border-radius: 5px !important;\n  border: 1.5px solid #444444 !important;\n  background: #1a1a1a !important;\n  flex-shrink: 0 !important;\n}\n.xt-list-item-on .xt-list-check { background: #444444 !important; border-color: #909090 !important; }\n.xt-list-item-on .xt-list-text { text-decoration: line-through !important; color: #555555 !important; }\n.xt-list-text { font-size: 12.5px !important; color: #e0e